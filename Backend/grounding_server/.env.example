# これを .env という名前で写して、どちらか 1 つを書く（.env は Git に入れない）。書いたら make down && make up。
# 届くかの確認: docker compose exec grounding_server python scripts/ws_client.py call llm.ping

# Claude のサブスクリプションを使う: ホストで `claude setup-token` を実行して出たトークン
CLAUDE_CODE_OAUTH_TOKEN=

# または Anthropic の API キー
# ANTHROPIC_API_KEY=

# 任意: モデルと effort（省略すると Claude Code の既定）
# COGROUND_LLM_MODEL=claude-opus-5-5
# COGROUND_LLM_EFFORT=low
